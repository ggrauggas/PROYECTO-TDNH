# ─────────────────────────────────────────────────────────────
# backend/.env.example
# Variables del backend Express.
# ─────────────────────────────────────────────────────────────

# Entorno
NODE_ENV=production
PORT=3000

# ── Base de datos ──
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tudiabetes
DB_USER=tudiabetes_user
DB_PASSWORD=tudiabetes_password

# ── Autenticación ──
JWT_SECRET=genera_un_secreto_aleatorio_de_al_menos_48_bytes
JWT_EXPIRES_IN=7d

# ── CORS ──
CORS_ORIGIN=https://tu-sitio.netlify.app
